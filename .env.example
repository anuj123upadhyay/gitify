# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id

# Database and Collection IDs (Get these from your Appwrite console)
NEXT_PUBLIC_DATABASE_ID=your-database-id
NEXT_PUBLIC_COLLECTION_USERS=your-users-collection-id
NEXT_PUBLIC_COLLECTION_REPOSITORIES=your-repositories-collection-id
NEXT_PUBLIC_COLLECTION_NOTIFICATIONS=your-notifications-collection-id

# Function IDs (Get these from your Appwrite console)
NEXT_PUBLIC_FUNCTION_POLLING=your-polling-function-id

# GitHub Configuration (Required for polling function)
GITHUB_TOKEN=your-github-personal-access-token

# Appwrite API Key (Required for setup scripts - Server-side only)
APPWRITE_API_KEY=your-appwrite-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Configuration (Optional - can use Appwrite's built-in SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
